# ====================================
# AI API Configuration
# ====================================

# OpenAI API Key for GPT models
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter API Key (for multiple AI models)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# NagaAPI Key for Naga models
NAGA_API_KEY=your_naga_api_key_here

# Anthropic API Key for Claude models
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google API Key for Gemini/PaLM models
GOOGLE_API_KEY=your_google_api_key_here

# DeepSeek API Key
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ====================================
# Application Configuration
# ====================================

# Environment (development, staging, production)
ENVIRONMENT=development

# Debug mode
DEBUG=True


Write-Host "  IMPORTANT: Update .env with your actual API keys!" -ForegroundColor Magenta
Write-Host "  NOTE: .env is in .gitignore and will NOT be committed" -ForegroundColor Cyan

# Step 8: Add dependencies
Write-Host "
[8/11] Adding dependencies..." -ForegroundColor Yellow
Write-Host "  - Adding python-dotenv..." -ForegroundColor Gray
python -m uv add python-dotenv
if (0 -ne 0) { exit 0 }

Write-Host "  - Adding dev dependencies (black, isort)..." -ForegroundColor Gray
python -m uv add --dev black isort
if (0 -ne 0) { exit 0 }

# Step 9: Format code
Write-Host "
[9/11] Formatting code..." -ForegroundColor Yellow
python -m uv run black .
python -m uv run isort .

# Step 10: Configure Git for cross-platform compatibility
Write-Host "
[10/11] Configuring Git for LF line endings..." -ForegroundColor Yellow
git config core.autocrlf false

# Create .gitattributes
@"
# Enforce LF line endings for all text files
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted to native line endings on checkout
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
